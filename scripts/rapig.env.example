# Rapig runtime configuration. Installed to /opt/rapig/rapig.env (mode 0600).
#
# systemd reads this file through EnvironmentFile; `rapig config` edits it and
# `rapig config --show` prints it. After a change: sudo rapig service restart.

# The service listens on loopback only; expose it through nginx/Caddy.
RAPIG_ADDR=127.0.0.1:50011

# Data directory: database, blobs, bootstrap secrets.
RAPIG_DATA_DIR=/opt/rapig/data

# Memory profile: low (512 MB baseline) or high (4 GB+ hosts).
RAPIG_PROFILE=low

# Secure cookie flag: auto (behind HTTPS reverse proxy) | always | never.
RAPIG_COOKIE_SECURE=auto

# Optional: expose the Go pprof endpoint on loopback for profiling.
#RAPIG_PPROF=127.0.0.1:6060

# Optional: external worker instead of the one embedded in `serve`.
#RAPIG_WORKER=external

# Optional: qBittorrent WebUI for magnet/torrent offline downloads.
#RAPIG_QB_URL=http://127.0.0.1:8080
#RAPIG_QB_USERNAME=admin
#RAPIG_QB_PASSWORD=change-me
